{
  "$defs": {
    "Localhost": {
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "enabled": {
          "description": "Enabled must be true for the connection to be valid",
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "type": "object"
    },
    "OpenSSH": {
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "address": {
          "description": "Address of the remote host",
          "type": "string"
        },
        "configPath": {
          "description": "Path to SSH config file",
          "type": "string"
        },
        "disableMultiplexing": {
          "default": false,
          "description": "Disable SSH connection multiplexing",
          "type": "boolean"
        },
        "keyPath": {
          "description": "Path to SSH private key",
          "type": "string"
        },
        "options": {
          "$ref": "#/$defs/OpenSSHOptions",
          "description": "Additional SSH options as key-value pairs (e.g. StrictHostKeyChecking: false)"
        },
        "port": {
          "description": "Optional SSH port",
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "user": {
          "description": "Optional SSH user",
          "type": "string"
        }
      },
      "required": [
        "address"
      ],
      "type": "object"
    },
    "OpenSSHOptions": {
      "type": "object"
    },
    "SSH": {
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "address": {
          "description": "Address of the remote host (IP or hostname)",
          "type": "string"
        },
        "bastion": {
          "$ref": "#/$defs/SSH",
          "description": "Optional bastion host"
        },
        "hostKey": {
          "description": "Optional known host key fingerprint",
          "type": "string"
        },
        "keyPath": {
          "description": "Optional path to private key",
          "type": "string"
        },
        "port": {
          "default": 22,
          "description": "SSH port (default 22)",
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "user": {
          "default": "root",
          "description": "User to log in as",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "address"
      ],
      "type": "object"
    },
    "WinRM": {
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "address": {
          "description": "Address of the remote host",
          "type": "string"
        },
        "bastion": {
          "$ref": "#/$defs/SSH",
          "description": "Optional SSH bastion"
        },
        "caCertPath": {
          "description": "Path to CA certificate",
          "type": "string"
        },
        "certPath": {
          "description": "Path to client certificate",
          "type": "string"
        },
        "insecure": {
          "default": false,
          "description": "Accept invalid TLS certificates",
          "type": "boolean"
        },
        "keyPath": {
          "description": "Path to client key",
          "type": "string"
        },
        "password": {
          "description": "Password for WinRM authentication",
          "type": "string"
        },
        "port": {
          "default": 5985,
          "description": "WinRM port",
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "tlsServerName": {
          "description": "TLS server name override",
          "type": "string"
        },
        "useHttps": {
          "default": false,
          "description": "Use HTTPS for WinRM",
          "type": "boolean"
        },
        "useNtlm": {
          "default": false,
          "description": "Use NTLM authentication",
          "type": "boolean"
        },
        "user": {
          "default": "Administrator",
          "description": "User to authenticate as",
          "minLength": 3,
          "type": "string"
        }
      },
      "required": [
        "address"
      ],
      "type": "object"
    },
    "ZarfClusterConfig": {
      "additionalProperties": false,
      "description": "for a cluster",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "loadbalancer": {
          "format": "hostname",
          "type": "string"
        },
        "profiles": {
          "items": {
            "$ref": "#/$defs/ZarfClusterProfiles"
          },
          "type": "array"
        },
        "registries": {
          "items": {
            "$ref": "#/$defs/ZarfClusterRegistries"
          },
          "type": "array"
        }
      },
      "required": [
        "loadbalancer"
      ],
      "type": "object"
    },
    "ZarfClusterFiles": {
      "additionalProperties": false,
      "description": "data",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "data": {
          "type": "string"
        },
        "dst": {
          "type": "string"
        },
        "dstDir": {
          "type": "string"
        },
        "group": {
          "examples": [
            "root"
          ],
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "perm": {
          "type": "string"
        },
        "src": {
          "type": "string"
        },
        "user": {
          "examples": [
            "root"
          ],
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "ZarfClusterMetadata": {
      "additionalProperties": false,
      "description": "a cluster config",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "name": {
          "description": "acts as the name of the cluster if you allow cargoship to add it to the kubeconfig",
          "pattern": "^[a-z0-9][a-z0-9\\-]*$",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "ZarfClusterProfiles": {
      "additionalProperties": false,
      "description": "for the engine",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "engineConfig": {
          "type": "object"
        },
        "kubeletConfig": {
          "type": "object"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "ZarfClusterRegistries": {
      "additionalProperties": false,
      "description": "overrides",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "auth": {
          "$ref": "#/$defs/ZarfClusterRegistryAuth",
          "description": "for the registry"
        },
        "name": {
          "description": "of the registry",
          "type": "string"
        },
        "proxy": {
          "$ref": "#/$defs/ZarfClusterRegistryProxy",
          "description": "for the registry"
        }
      },
      "required": [
        "name",
        "proxy"
      ],
      "type": "object"
    },
    "ZarfClusterRegistryAuth": {
      "additionalProperties": false,
      "description": "information",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "pass": {
          "description": "for the remote registry",
          "type": "string"
        },
        "token": {
          "description": "for the remote registry",
          "type": "string"
        },
        "user": {
          "description": "for the remote registry",
          "type": "string"
        }
      },
      "type": "object"
    },
    "ZarfClusterRegistryProxy": {
      "additionalProperties": false,
      "description": "override for the registry information",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "url": {
          "description": "to the registry that will engine will now pull from",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    },
    "ZarfClusterSpec": {
      "additionalProperties": false,
      "description": "a cluster config",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "config": {
          "$ref": "#/$defs/ZarfClusterConfig"
        },
        "hosts": {
          "$ref": "#/$defs/ZarfHosts"
        }
      },
      "required": [
        "config",
        "hosts"
      ],
      "type": "object"
    },
    "ZarfFirewallPolicyConfig": {
      "additionalProperties": false,
      "description": "is used in the inventory file to allow opening ports from one zone to another with firewalld policies",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "egress": {
          "$ref": "#/$defs/ZarfFirewallZone"
        },
        "ingress": {
          "$ref": "#/$defs/ZarfFirewallZone"
        },
        "ports": {
          "items": {
            "$ref": "#/$defs/ZarfFirewallPort"
          },
          "type": "array"
        },
        "target": {
          "enum": [
            "CONTINUE",
            "ACCEPT",
            "REJECT",
            "DROP"
          ],
          "type": "string"
        }
      },
      "required": [
        "target",
        "ingress",
        "egress"
      ],
      "type": "object"
    },
    "ZarfFirewallPort": {
      "additionalProperties": false,
      "description": "is used to define what ports are allowed thru the firewalld policy",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "port": {
          "description": "the port number, or range, that will be opened",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ]
        },
        "protocol": {
          "description": "the type of allowed traffic",
          "enum": [
            "tcp",
            "udp",
            "sctp",
            "dccp"
          ],
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "port"
      ],
      "type": "object"
    },
    "ZarfFirewallZone": {
      "additionalProperties": false,
      "description": "name of either the ingress or egress zone for the policy",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "name": {
          "examples": [
            "trusted",
            "public"
          ],
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "ZarfHost": {
      "additionalProperties": false,
      "description": "is a remote connection to a node",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "a map of environment variables that will be populated on the host system",
          "type": "object"
        },
        "files": {
          "description": "that will be uploaded to a host",
          "items": {
            "$ref": "#/$defs/ZarfClusterFiles"
          },
          "type": "array"
        },
        "hostname": {
          "description": "overrides the name of the node",
          "type": "string"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "a map of node labels variables",
          "type": "object"
        },
        "localhost": {
          "$ref": "#/$defs/Localhost"
        },
        "openSSH": {
          "$ref": "#/$defs/OpenSSH"
        },
        "policy": {
          "additionalProperties": {
            "$ref": "#/$defs/ZarfFirewallPolicyConfig"
          },
          "description": "firewalld policies to allow traffic from one interface to another",
          "type": "object"
        },
        "ports": {
          "description": "are a list of ports and protocols that will be opened on a specfic node",
          "items": {
            "$ref": "#/$defs/ZarfHostPort"
          },
          "type": "array"
        },
        "privateAddress": {
          "description": "override the given private address",
          "type": "string"
        },
        "privateInterface": {
          "description": "override the given private interface",
          "type": "string"
        },
        "profile": {
          "description": "is the name of the profile that should be used in the config",
          "type": "string"
        },
        "role": {
          "description": "of this node will be applied when adding nodes to the cluster;\noptions are either controller or worker.",
          "enum": [
            "controller",
            "worker"
          ],
          "type": "string"
        },
        "ssh": {
          "$ref": "#/$defs/SSH"
        },
        "taints": {
          "description": "that will be applied to the distro specific config that will be applied to the node",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "winRm": {
          "$ref": "#/$defs/WinRM"
        }
      },
      "required": [
        "role"
      ],
      "type": "object"
    },
    "ZarfHostPort": {
      "additionalProperties": false,
      "description": "ports that should be opened on the public side of the firewall",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "port": {
          "description": "the port number, or range, that will be opened",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ]
        },
        "protocol": {
          "description": "the type of allowed traffic",
          "enum": [
            "tcp",
            "udp"
          ],
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "port"
      ],
      "type": "object"
    },
    "ZarfHosts": {
      "description": "are the hosts that will be managed",
      "items": {
        "$ref": "#/$defs/ZarfHost"
      },
      "type": "array"
    }
  },
  "$id": "https://github.com/colonel-byte/cargoship/src/api/zarf.dev/v1alpha1/cluster/zarf-cluster",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "root for a cluster config",
  "patternProperties": {
    "^x-": {}
  },
  "properties": {
    "apiVersion": {
      "enum": [
        "zarf.dev/v1alpha1"
      ],
      "type": "string"
    },
    "kind": {
      "enum": [
        "ZarfCluster"
      ],
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/ZarfClusterMetadata"
    },
    "spec": {
      "$ref": "#/$defs/ZarfClusterSpec"
    }
  },
  "required": [
    "kind",
    "metadata",
    "spec"
  ],
  "type": "object"
}
