{
  "$defs": {
    "BinarySelector": {
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "package": {
          "enum": [
            "rpm",
            "apt",
            "binary"
          ],
          "type": "string"
        },
        "profile": {
          "enum": [
            "worker",
            "controller"
          ],
          "type": "string"
        },
        "roles": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Mapping": {
      "type": "object"
    },
    "SetValue": {
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "key": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "value": true
      },
      "type": "object"
    },
    "Shell": {
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "darwin": {
          "description": "(default 'sh') Indicates a preference for the shell to use on macOS systems",
          "examples": [
            "sh",
            "bash",
            "fish",
            "zsh",
            "pwsh"
          ],
          "type": "string"
        },
        "linux": {
          "description": "(default 'sh') Indicates a preference for the shell to use on Linux systems",
          "examples": [
            "sh",
            "bash",
            "fish",
            "zsh",
            "pwsh"
          ],
          "type": "string"
        },
        "windows": {
          "description": "(default 'powershell') Indicates a preference for the shell to use on Windows systems (note that choosing 'cmd' will turn off migrations like touch -\u003e New-Item)",
          "examples": [
            "powershell",
            "cmd",
            "pwsh",
            "sh",
            "bash",
            "gsh"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "Variable": {
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "autoIndent": {
          "type": "boolean"
        },
        "name": {
          "pattern": "^[A-Z0-9_]+$",
          "type": "string"
        },
        "pattern": {
          "type": "string"
        },
        "sensitive": {
          "type": "boolean"
        },
        "type": {
          "enum": [
            "raw",
            "file"
          ],
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "ZarfComponentAction": {
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "cmd": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "dir": {
          "type": "string"
        },
        "env": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "maxRetries": {
          "type": "integer"
        },
        "maxTotalSeconds": {
          "type": "integer"
        },
        "mute": {
          "type": "boolean"
        },
        "setValues": {
          "items": {
            "$ref": "#/$defs/SetValue"
          },
          "type": "array"
        },
        "setVariable": {
          "pattern": "^[A-Z0-9_]+$",
          "type": "string"
        },
        "setVariables": {
          "items": {
            "$ref": "#/$defs/Variable"
          },
          "type": "array"
        },
        "shell": {
          "$ref": "#/$defs/Shell"
        },
        "template": {
          "type": "boolean"
        },
        "wait": {
          "$ref": "#/$defs/ZarfComponentActionWait"
        }
      },
      "type": "object"
    },
    "ZarfComponentActionDefaults": {
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "dir": {
          "type": "string"
        },
        "env": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "maxRetries": {
          "type": "integer"
        },
        "maxTotalSeconds": {
          "type": "integer"
        },
        "mute": {
          "type": "boolean"
        },
        "shell": {
          "$ref": "#/$defs/Shell"
        }
      },
      "type": "object"
    },
    "ZarfComponentActionSet": {
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "after": {
          "items": {
            "$ref": "#/$defs/ZarfComponentAction"
          },
          "type": "array"
        },
        "before": {
          "items": {
            "$ref": "#/$defs/ZarfComponentAction"
          },
          "type": "array"
        },
        "defaults": {
          "$ref": "#/$defs/ZarfComponentActionDefaults"
        },
        "onFailure": {
          "items": {
            "$ref": "#/$defs/ZarfComponentAction"
          },
          "type": "array"
        },
        "onSuccess": {
          "items": {
            "$ref": "#/$defs/ZarfComponentAction"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "ZarfComponentActionWait": {
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "cluster": {
          "$ref": "#/$defs/ZarfComponentActionWaitCluster"
        },
        "network": {
          "$ref": "#/$defs/ZarfComponentActionWaitNetwork"
        }
      },
      "type": "object"
    },
    "ZarfComponentActionWaitCluster": {
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "condition": {
          "examples": [
            "Ready",
            "Available"
          ],
          "type": "string"
        },
        "kind": {
          "examples": [
            "Pod",
            "Deployment"
          ],
          "type": "string"
        },
        "name": {
          "examples": [
            "podinfo",
            "app=podinfo"
          ],
          "type": "string"
        },
        "namespace": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "type": "object"
    },
    "ZarfComponentActionWaitNetwork": {
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "address": {
          "examples": [
            "localhost:8080",
            "1.1.1.1"
          ],
          "type": "string"
        },
        "code": {
          "examples": [
            200,
            404
          ],
          "type": "integer"
        },
        "protocol": {
          "enum": [
            "tcp",
            "http",
            "https"
          ],
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "address"
      ],
      "type": "object"
    },
    "ZarfDistroActions": {
      "additionalProperties": false,
      "description": "that are ran during certain phases of the distro package",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "onCreate": {
          "$ref": "#/$defs/ZarfComponentActionSet",
          "description": "actions"
        }
      },
      "type": "object"
    },
    "ZarfDistroBuildData": {
      "additionalProperties": false,
      "description": "time information",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "architecture": {
          "description": "of the distro package",
          "type": "string"
        },
        "provenanceFiles": {
          "description": "lists files present in the package that are not included in checksums.txt.\nThese are files added after checksum generation (e.g., signature files).\nThis list is authenticated through the signed zarf.yaml.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "registryOverrides": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "for who the distro was created with",
          "type": "object"
        },
        "signed": {
          "description": "Whether this package was signed",
          "type": "boolean"
        },
        "timestamp": {
          "description": "of when the distro was created",
          "type": "string"
        },
        "version": {
          "description": "of the distro is created as",
          "type": "string"
        }
      },
      "type": "object"
    },
    "ZarfDistroConfig": {
      "additionalProperties": false,
      "description": "holds values for distro config",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "engine": {
          "$ref": "#/$defs/Mapping",
          "description": "is used for configuring the engine"
        },
        "files": {
          "$ref": "#/$defs/ZarfFiles",
          "description": "are files that will be populated on the hosts, regardless of what install method is used"
        },
        "imageConfig": {
          "$ref": "#/$defs/ZarfDistroImageConfig",
          "description": "for the images"
        },
        "os": {
          "$ref": "#/$defs/ZarfDistroOS",
          "description": "for the node os"
        }
      },
      "type": "object"
    },
    "ZarfDistroImageConfig": {
      "additionalProperties": false,
      "description": "holds values for the images that will be populated on a host",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "compression": {
          "default": "none",
          "description": "that the image tar balls will be compressed with",
          "enum": [
            "none",
            "gz",
            "zstd"
          ],
          "type": "string"
        },
        "images": {
          "description": "list of the various required offline images",
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "path": {
          "description": "that the image tar balls will be uploaded too",
          "type": "string"
        }
      },
      "type": "object"
    },
    "ZarfDistroMetadata": {
      "additionalProperties": false,
      "description": "for the distro package",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "aggregateChecksum": {
          "description": "of a checksums.txt file that contains checksums all the layers within the package.",
          "type": "string"
        },
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "that will be added to the OCI manifest",
          "type": "object"
        },
        "architecture": {
          "default": "amd64",
          "description": "the CPU architecture this distro is built for",
          "enum": [
            "amd64",
            "arm64"
          ],
          "type": "string"
        },
        "athors": {
          "description": "is used by the oci annotation for the contact details of the people or organization responsible for the image (freeform string).",
          "type": "string"
        },
        "description": {
          "description": "of what this distro package is created to do",
          "type": "string"
        },
        "documentation": {
          "description": "source is used by the oci annotation for the URL to get documentation on the image.",
          "type": "string"
        },
        "name": {
          "description": "of the distro package",
          "pattern": "^[a-z0-9][a-z0-9\\-]*$",
          "type": "string"
        },
        "source": {
          "description": "is used by the oci annotation for the URL to get source code for building the image.",
          "type": "string"
        },
        "uncompressed": {
          "description": "indicates if this package should be compressed or not",
          "type": "boolean"
        },
        "url": {
          "description": "is used by the oci annotation for the URL to find more information on the image.",
          "type": "string"
        },
        "vendor": {
          "description": "is used by the oci annotation for the name of the distributing entity, organization or individual.",
          "type": "string"
        },
        "version": {
          "description": "of the distro that will be installed, suggested to align to the kubernetes version being installed",
          "type": "string"
        }
      },
      "required": [
        "uncompressed",
        "name"
      ],
      "type": "object"
    },
    "ZarfDistroOS": {
      "additionalProperties": false,
      "description": "holds specific values for apply to a host",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "a map of environment variables that will be populated on the host system",
          "type": "object"
        },
        "fapolicyd": {
          "description": "config file contents that will be applied to a host",
          "type": "string"
        },
        "files": {
          "$ref": "#/$defs/ZarfFiles",
          "description": "that will be uploaded to a host"
        },
        "kernel": {
          "description": "list of the requested kerenel modules to be enabled on the host system",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sysctl": {
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          },
          "description": "a map of sysctl values that will be applied to a host",
          "type": "object"
        }
      },
      "type": "object"
    },
    "ZarfDistroSpec": {
      "additionalProperties": false,
      "description": "that manage the distro spec",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "actions": {
          "$ref": "#/$defs/ZarfDistroActions",
          "description": "that are ran during some package phases"
        },
        "config": {
          "$ref": "#/$defs/ZarfDistroConfig",
          "description": "for the distro"
        },
        "type": {
          "description": "of distro that is being created",
          "enum": [
            "rke2",
            "k3s"
          ],
          "type": "string"
        },
        "version": {
          "description": "of the engine",
          "type": "string"
        }
      },
      "required": [
        "type",
        "version",
        "config"
      ],
      "type": "object"
    },
    "ZarfFile": {
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "data": {
          "type": "string"
        },
        "executable": {
          "type": "boolean"
        },
        "extractPath": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "isDirectory": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "perm": true,
        "selector": {
          "$ref": "#/$defs/BinarySelector"
        },
        "shasum": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "symlinks": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "target": {
          "type": "string"
        },
        "user": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "type": "object"
    },
    "ZarfFiles": {
      "items": {
        "$ref": "#/$defs/ZarfFile"
      },
      "type": "array"
    }
  },
  "$id": "https://github.com/colonel-byte/cargoship/src/api/zarf.dev/v1alpha1/distro/zarf-distro",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "root information",
  "patternProperties": {
    "^x-": {}
  },
  "properties": {
    "apiVersion": {
      "enum": [
        "zarf.dev/v1alpha1"
      ],
      "type": "string"
    },
    "build": {
      "$ref": "#/$defs/ZarfDistroBuildData"
    },
    "kind": {
      "enum": [
        "ZarfDistro"
      ],
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/ZarfDistroMetadata"
    },
    "spec": {
      "$ref": "#/$defs/ZarfDistroSpec"
    }
  },
  "required": [
    "kind",
    "metadata",
    "spec"
  ],
  "type": "object"
}
