#cloud-config
# Rendered by test/microvm. Consumed once, by cloud-init, from a NoCloud vfat seed.
fqdn: {{ .Name }}.{{ .Domain }}
preserve_hostname: false
ssh_pwauth: false
disable_root: false
users:
  - name: root
    ssh_authorized_keys:
      - {{ .PublicKey }}
# The packages and the commands come from the image, because what cargoship routes to differs
# by distribution: firewalld and fapolicyd on Enterprise Linux, ufw on Debian. Each phase that
# gates on one of these asks whether the service is *running*, so a node without them is a node
# where that phase correctly does nothing and the branch stays untested.
#
# SELinux is deliberately left at the image default. The fleet asserts what the guest enforces
# rather than arranging for it.
{{- if .Packages }}
packages:
{{- range .Packages }}
  - {{ . }}
{{- end }}
{{- end }}
{{- if .RunCmd }}
runcmd:
{{- range .RunCmd }}
  - {{ . }}
{{- end }}
{{- end }}
