{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["replicas"],
  "properties": {
    "addons": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disabled": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["rke2-coredns", "rke2-ingress-nginx", "rke2-metrics-server"]
          },
          "uniqueItems": true
        }
      }
    },
    "replicas": {
      "type": "integer",
      "minimum": 1
    }
  }
}
