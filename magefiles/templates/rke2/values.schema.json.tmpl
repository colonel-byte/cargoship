{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "rancher-rke2-{{ .Name }} values",
  "description": "Generated in magefiles/templates/rke2/values.schema.json.tmpl.",
  "type": "object",
  "properties": {
{{- if eq .CNI "cilium" }}
    "cilium": {
      "type": "object",
      "properties": {
        "encryption": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Encrypt pod-to-pod traffic with WireGuard."
            }
          },
          "additionalProperties": false
        },
        "l2announcements": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Announce LoadBalancer addresses over ARP."
            }
          },
          "additionalProperties": false
        },
        "hubble": {
          "type": "object",
          "properties": {
            "ui": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "Run the Hubble UI and its relay."
                },
                "ipv6": {
                  "type": "boolean",
                  "description": "Serve the Hubble UI frontend over IPv6."
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
{{- end }}
    "addons": {
      "type": "object",
      "properties": {
        "disabled": {
          "type": "array",
          "description": "The bundled charts rke2 is told not to install. Replaces the package's own list rather than adding to it. Only the components rke2 {{ .Minor }} packages are accepted.",
          "items": {
            "type": "string",
            "enum": [
{{- range $i, $addon := .Addons }}{{ if $i }},{{ end }}
              {{ printf "%q" $addon }}
{{- end }}
            ]
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
