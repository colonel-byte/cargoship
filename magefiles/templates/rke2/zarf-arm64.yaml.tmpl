---
{{- with .ArchByName "arm64" }}
apiVersion: zarf.dev/v1alpha1
kind: ZarfPackageConfig
metadata:
  name: {{ $.Name }}-content-arm64
  version: {{ $.Version }}
  description: Images and files for the cargoship {{ $.Name }} {{ $.Version }} example on arm64
  architecture: arm64
components:
  - name: images
    required: true
    images:
{{- range $.CoreImages }}
      - {{ . }}
{{- end }}
{{- range $.CNIImages }}
      - {{ . }}
{{- end }}
{{- range $chart, $images := $.ChartImages }}
{{- range $images }}
      - {{ . }}
{{- end }}
{{- end }}
  - name: files
    required: true
    # Each target is unused by cargoship, which reads a package's files by the source they
    # declare; zarf requires one, and its basename is what the staged file is called.
    files:
{{- range $url := $.ContentFiles "arm64" }}
      - source: {{ $url }}
        target: /var/lib/cargoship/content/{{ base $url }}
{{- with sha256 $url }}
        shasum: {{ . }}
{{- end }}
{{- end }}
{{- end }}
