---
# This file is generated in magefiles/templates/rke2/values.yaml.tmpl.

# The values this package is built with. A cluster overrides any of them in its
# inventory file under spec.config.values, and cargoship checks the result
# against values.schema.json before it installs anything.

# yaml-language-server: $schema=values.schema.json
addons:
  # The bundled charts rke2 is told not to install. Setting this in an inventory
  # replaces the whole list rather than adding to it, so name every chart the
  # cluster wants left out, including the ones listed here.
  #
  # values.schema.json carries the charts rke2 {{ .Minor }} packages, extracted
  # from the engine's source, and an editor offers them here as completions. That
  # list is the engine's own --disable help text, which does not name every chart
  # the build bundles, so any rke2- chart is accepted rather than only those --
  # cargoship warns when it configures a node with one this build does not package.
  disabled:
    - rke2-ingress-nginx
{{- if eq .CloudProvider "rancher-vsphere" }}
  vsphere:
    # Which of the bundled vSphere charts this cluster runs. Turning one off keeps
    # its images in the package and stops them being uploaded, and writes no
    # HelmChartConfig for it.
    #
    # The two are not independent: the CSI driver reads the ProviderID the CPI sets
    # on each node, so CSI without CPI does not work. CPI without CSI is ordinary --
    # vSphere for node metadata and load balancers, something else for storage.
    cpi:
      enabled: true
      # tolerations:
      #   - operator: Exists
      # nodeSelector:
      #   node-role.kubernetes.io/control-plane: "true"
      #
      # The ConfigMap the CPI reads its cloud config from, mounted at /etc/cloud. Set
      # generate: false to supply your own instead of having the chart render one -- which is
      # the only way to give the CPI a CA certificate, since the chart exposes no value for
      # one. Your ConfigMap then needs two kinds of entry:
      #
      #   vsphere.yaml  the cloud config itself, including a caFile line
      #   <any key>     the vCenter CA, PEM-encoded
      #
      # The whole ConfigMap mounts as a directory, so a key named vcenter-ca.pem lands at
      # /etc/cloud/vcenter-ca.pem, which is what caFile points at. The key name is the file
      # name; a DER or PKCS#12 certificate will not do, the drivers read PEM.
      #
      # Set insecure: false alongside it. Upstream ignores caFile entirely while the insecure
      # flag is on, so leaving it true means the certificate is loaded and never checked. The
      # CSI driver takes a CA the same way -- see auth.secret.generate and csiName.
      # cloudConfig:
      #   generate: false
      #   name: vsphere-cloud-config
    csi:
      enabled: true
      storageClass:
        isDefault: true
      # node:
      #   tolerations:
      #     - operator: Exists
      #   nodeSelector:
      #     node-role.kubernetes.io/worker: "true"
      # controller:
      #   tolerations:
      #     - operator: Exists
      #   nodeSelector:
      #     node-role.kubernetes.io/control-plane: "true"
      #   affinity:
      #     podAntiAffinity:
      #       requiredDuringSchedulingIgnoredDuringExecution:
      #         - labelSelector:
      #             matchExpressions:
      #               - key: app
      #                 operator: In
      #                 values:
      #                   - vsphere-csi-controller
      #           topologyKey: kubernetes.io/hostname
    # Connection and credentials settings for vCenter:
    # host: ""
    # port: 443
    # insecure: true
    # datacenters: ""
    # clusterId: ""
    # auth:
    #   user: ""
    #   pass: ""
    #   secret:
    #     generate: true
    #     # Named separately on purpose -- the two charts generate two Secrets with different
    #     # contents, so one name collides them. Set these only to point the charts at Secrets
    #     # you created yourself, alongside generate: false.
    #     cpiName: vsphere-cpi-creds
    #     csiName: vsphere-config-secret
{{- end }}
{{- if eq .CNI "cilium" }}
cilium:
  encryption:
    # Transparent pod-to-pod encryption, using WireGuard. Costs throughput, so it
    # is off unless a cluster asks for it.
    enabled: false
  l2announcements:
    # Answer ARP for LoadBalancer addresses, so services are reachable on a flat
    # network with no BGP and no external load balancer.
    enabled: true
  hubble:
    ui:
      # The Hubble web interface, and the relay it reads from.
      enabled: true
      # Serve the interface over IPv6. Off because the frontend fails to start when
      # it binds IPv6 on a node that has none.
      ipv6: false
{{- end }}
{{- with .KubeVip }}
kubeVip:
  # Whether the controllers run kube-vip, which holds the cluster's control-plane VIP on
  # whichever of them wins its lease. Off by default: the VIP has to be an address nothing
  # else answers for, and a package cannot know that it is.
  #
  # The address is not stated here by default. It is the inventory's spec.config.loadbalancer,
  # which is already what joining controllers point `server:` at and what goes into the API
  # server's tls-san, so the cluster states it once; `address` below overrides it for the case
  # that cannot work. Turning this on with neither set fails the install with the file it could
  # not render, rather than installing a pod with no address.
  enabled: false
  # The kube-vip release this package carries the image for. Overriding it to something the
  # package does not carry leaves the static pod pulling from a registry an air-gapped host
  # cannot reach.
  image: {{ .Image }}
  # The address kube-vip advertises, when it must not be the one the inventory names.
  #
  # Empty takes spec.config.loadbalancer, which is the point of the `.Cluster` root and right
  # whenever that value is an IP or a name every controller already resolves. But the inventory
  # calls that field a *hostname*, and kube-vip resolving a name has to succeed on the
  # controller before the kubelet starts this pod -- cargoship does not put the load balancer in
  # /etc/hosts, so an air-gapped fleet whose DNS does not answer for it would get a pod that
  # cannot work out what to advertise. Set the IP the record points at here and leave
  # loadbalancer as the name. Do the same where loadbalancer is round-robin DNS, one A record
  # per controller: kube-vip would resolve it to one controller's own address and ARP for that,
  # taking the API server down in a way that reads as a network fault rather than as a value.
  address: ""
  # The interface the VIP is added to. Empty lets kube-vip take the host's default-gateway
  # interface, which is what makes one manifest correct across controllers whose NICs are not
  # named alike -- cargoship renders the manifest once for the cluster, not once per host.
  interface: ""
  # The prefix length the VIP is added with. A /32 is the address and nothing else.
  subnet: "{{ .Subnet }}"
  # The API server port kube-vip health-checks the control plane on.
  port: "{{ .Port }}"
  # Where the engine writes the admin kubeconfig kube-vip holds its lease with.
  kubeconfig: {{ .Kubeconfig }}
  # Leader election timings, in seconds. The defaults are kube-vip's own.
  leaseDuration: "5"
  renewDeadline: "3"
  retryPeriod: "1"
  # Where kube-vip serves its Prometheus endpoint. The pod is on the host network, so an
  # address other than loopback publishes an unauthenticated endpoint on every address the
  # controller has, the VIP included.
  metricsAddress: "{{ .MetricsAddress }}"
{{- end }}
podSecurity:
  defaults:
    enforce: restricted
    audit: restricted
    warn: restricted
  # Who pod security admission does not apply to. Setting one of these in an
  # inventory replaces the whole list rather than adding to it, so carry the
  # entries below that the cluster still needs -- kube-system and zarf hold
  # components that do not run under the restricted profile.
  exemptions:
    usernames: []
    runtimeClasses: []
    namespaces:
      - kube-system
      - rook-ceph
      - zarf
tools:
  etcdctl:
    # Optional debug CLI installed on control-plane hosts.
    enabled: false
