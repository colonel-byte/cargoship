# This file is generated in magefiles/templates/rke2/values.yaml.tmpl.

# The values this package is built with. A cluster overrides any of them in its
# inventory file under spec.config.values, and cargoship checks the result
# against values.schema.json before it installs anything.
addons:
  # The bundled charts rke2 is told not to install. Setting this in an inventory
  # replaces the whole list rather than adding to it, so name every chart the
  # cluster wants left out, including the ones listed here.
  #
  # rke2 ships rke2-coredns, rke2-ingress-nginx, rke2-metrics-server,
  # rke2-snapshot-controller, rke2-snapshot-controller-crd,
  # rke2-snapshot-validation-webhook, and, on builds that carry it, rke2-traefik
  # with rke2-traefik-crd.
  disabled:
    - rke2-ingress-nginx
{{- if eq .CNI "cilium" }}
cilium:
  encryption:
    # Transparent pod-to-pod encryption, using WireGuard. Costs throughput, so it
    # is off unless a cluster asks for it.
    enabled: false
  l2announcements:
    # Answer ARP for LoadBalancer addresses, so services are reachable on a flat
    # network with no BGP and no external load balancer.
    enabled: true
  hubble:
    ui:
      # The Hubble web interface, and the relay it reads from.
      enabled: true
      # Serve the interface over IPv6. Off because the frontend fails to start when
      # it binds IPv6 on a node that has none.
      ipv6: false
{{- end }}
