{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "rancher-k3s-{{ .Name }} values",
  "description": "Generated in magefiles/templates/k3s/values.schema.json.tmpl.",
  "type": "object",
  "properties": {
    "addons": {
      "type": "object",
      "properties": {
        "disabled": {
          "type": "array",
          "description": "The bundled charts k3s is told not to install. Replaces the package's own list rather than adding to it. Only the components k3s {{ .Minor }} packages are accepted.",
          "items": {
            "type": "string",
            "enum": [
{{- range $i, $addon := .Addons }}{{ if $i }},{{ end }}
              {{ printf "%q" $addon }}
{{- end }}
            ]
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
