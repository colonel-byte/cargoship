# This file is generated in magefiles/templates/k3s/values.yaml.tmpl.

# The values this package is built with. A cluster overrides any of them in its
# inventory file under spec.config.values, and cargoship checks the result
# against values.schema.json before it installs anything.
addons:
  # The bundled charts k3s is told not to install. Setting this in an inventory
  # replaces the whole list rather than adding to it, so name every chart the
  # cluster wants left out.
  #
  # k3s ships coredns, servicelb, traefik, local-storage, and metrics-server. This
  # package leaves all of them installed; a cluster that runs its own ingress or
  # its own load balancer names them here.
  disabled: []
