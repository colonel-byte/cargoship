# This file is generated in magefiles/templates/rke2-distro.yaml.tmpl, versions may need to updated over time.

---
# yaml-language-server: $schema=https://raw.githubusercontent.com/colonel-byte/cargoship/refs/heads/main/schema/zarf-v1alpha1-distro-package-schema.json
apiVersion: zarf.dev/v1alpha1
kind: ZarfDistro
metadata:
  name: rancher-rke2-{{ .Name }}
  version: {{ .Version }}
{{- if .MultiArch }}
  architectures:
{{- range .Arches }}
    - {{ .Arch }}
{{- end }}
{{- else }}
  architecture: {{ (index .Arches 0).Arch }}
{{- end }}
spec:
  type: rke2
  version: {{ .Version }}
  actions:
    onCreate:
      before:
        - description: pull rke2 tar-ball
          cmd: |-
            rm -rf   target
            mkdir -p target
{{- range $arch := .Arches }}
            echo https://github.com/rancher/rke2/releases/download/{{ $.TagURL }}/{{ $arch.Tarball }}
            curl -L -o ./target/{{ $arch.Tarball }} https://github.com/rancher/rke2/releases/download/{{ $.TagURL }}/{{ $arch.Tarball }}
{{- end }}
      after:
        - description: clean up after
          cmd: |-
            rm -rf   target
  config:
    engine:
      config:
        cluster-cidr: 10.42.0.0/16
        cluster-domain: cluster.local
        cni:
          - {{ .CNI }}
        disable-cloud-controller: true
{{- if .CloudProvider }}
        # rke2 rewrites this to "external", forces disable-cloud-controller and deploys the
        # provider's bundled CPI and CSI charts. Every other bundled provider is disabled.
        cloud-provider-name: {{ .CloudProvider }}
{{- end }}
{{- if .ReplacesKubeProxy }}
        disable-kube-proxy: true
{{- end }}
        disable:
          - rke2-ingress-nginx
        embedded-registry: false
        etcd-arg:
          - "quota-backend-bytes=8589934592" # 8GB
          - "auto-compaction-retention=1h"
        kube-apiserver-arg:
          - anonymous-auth=false
          - audit-log-mode=blocking-strict
          - audit-log-maxage=30
          - authorization-mode=RBAC,Node
          - "tls-min-version=VersionTLS12"
          - "service-account-extend-token-expiration=false"
          - "tls-cipher-suites=TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256,TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256,TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305,TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384,TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305,TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384"
        kube-controller-manager-arg:
          - "tls-min-version=VersionTLS12"
          - "tls-cipher-suites=TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256,TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256,TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305,TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384,TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305,TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384"
          - bind-address=127.0.0.1
          - use-service-account-credentials=true
        kube-proxy-arg:
          - "ipvs-strict-arp=true"
        kube-scheduler-arg:
          - "tls-min-version=VersionTLS12"
          - "tls-cipher-suites=TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256,TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256,TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305,TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384,TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305,TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384"
        kubelet-arg:
          - authorization-mode=Webhook
          - anonymous-auth=false
          - streaming-connection-idle-timeout=5m
          - read-only-port=0
        profile: cis
        protect-kernel-defaults: true
        selinux: true
        service-cidr: 10.43.0.0/16
        write-kubeconfig-mode: "0600"
      audit:
        rules:
          - level: None
      podSecurity:
        plugins:
          - name: PodSecurity
            configuration:
              apiVersion: pod-security.admission.config.k8s.io/v1beta1
              kind: PodSecurityConfiguration
              defaults:
                enforce: "restricted"
                enforce-version: "latest"
                audit: "restricted"
                audit-version: "latest"
                warn: "restricted"
                warn-version: "latest"
              exemptions:
                usernames: []
                runtimeClasses: []
                namespaces:
                  - kube-system
                  - rook-ceph
                  - zarf
{{- if or (eq .CNI "cilium") .CloudProvider }}
      manifest:
{{- end }}
{{- if eq .CNI "cilium" }}
        rke2-cilium:
          kubeProxyReplacement: true
          k8sServiceHost: "localhost"
          k8sServicePort: 6443
          l2announcements:
            enabled: true
          encryption:
            enabled: {{ .Encryption }}
            type: wireguard
          tolerations:
            - operator: Exists
          operator:
            tolerations:
              - operator: Exists
          cni:
            exclusive: false
          bandwidthManager:
            enabled: false
          bpf:
            masquerade: true
          socketLB:
            hostNamespaceOnly: true
            enabled: true
          localRedirectPolicies:
            enabled: true
          hostFirewall:
            enabled: false
          enablePolicy: default
          hubble:
            enabled: true
            relay:
              enabled: true
              tolerations:
                - operator: Exists
            ui:
              enabled: true
              frontend:
                server:
                  ipv6:
                    enabled: false
              tolerations:
                - operator: Exists
{{- end }}
{{- if eq .CloudProvider "rancher-vsphere" }}
        rancher-vsphere-cpi: |-
          vCenter:
            # These are placeholders: an example cannot know the vCenter it will run against,
            # and credentials do not belong in a package. Fill them in, or replace the
            # generated secret with your own, before building this example.
            host: ""
            port: 443
            insecureFlag: true
            datacenters: ""
            username: ""
            password: ""
            credentialsSecret:
              name: vsphere-cpi-creds
              generate: true
        rancher-vsphere-csi: |-
          vCenter:
            # Placeholders, as above. clusterId has to be unique per cluster sharing a vCenter.
            host: ""
            port: 443
            insecureFlag: "1"
            clusterId: ""
            datacenters: ""
            username: ""
            password: ""
            configSecret:
              name: vsphere-config-secret
              generate: true
          storageClass:
            enabled: true
            name: vsphere-csi-sc
            isDefault: true
            datastoreURL: ""
{{- end }}
    os:
      sysctl:
        # Istio related sysctl overrides
        "fs.inotify.max_user_watches": 11048576
        "fs.inotify.max_user_instances": 8192
        # Misc performance
        "vm.max_map_count": 262144
        "fs.file-max": 2097152
        # Network tuning
        "net.core.somaxconn": 32768
        "net.ipv4.tcp_max_syn_backlog": 8192
        "net.core.netdev_max_backlog": 16384
        # NFTABLES
        "net.netfilter.nf_conntrack_max": 1000000
        "net.netfilter.nf_conntrack_buckets": 250000
        "net.netfilter.nf_conntrack_tcp_timeout_established": 86400
        "net.netfilter.nf_conntrack_tcp_timeout_close_wait": 3600
        # Network
        "net.ipv4.ip_forward": 1
        "net.ipv6.conf.all.forwarding": 1
        "net.bridge.bridge-nf-call-iptables": 1
        "net.bridge.bridge-nf-call-ip6tables": 1
        # RKE2 related sysctl overrides
        "vm.panic_on_oom": 0
        "vm.overcommit_memory": 1
        "kernel.panic": 10
        "kernel.panic_on_oops": 1
      fapolicyd: |
        # Allow RKE2 to function
        allow perm=any all : dir=/opt/cni/
        allow perm=any all : dir=/run/k3s/
        allow perm=any all : dir=/var/lib/kubelet/
        allow perm=any all : dir=/var/lib/rancher/
      files:
{{- $selinuxRPM := .SelinuxRPM }}
{{- if .MultiArch }}
        # One set of RPMs and one tarball per architecture, each landing at the same target.
        # The selector decides which set a host receives; an entry without an arch selector
        # goes to every host.
{{- end }}
{{- range $arch := .Arches }}
        - source: {{ $arch.CommonRPM }}
          target: /var/lib/rancher/rke2/rpm/rke2-common-{{ $.RPMVersion }}-0.el9.{{ $arch.RPMArch }}.rpm
{{- with sha256 $arch.CommonRPM }}
          shasum: {{ . }}
{{- end }}
          selector:
            package: rpm
{{- if $.MultiArch }}
            arch:
              - {{ $arch.Arch }}
{{- end }}
{{- end }}
        - source: {{ $selinuxRPM }}
          target: /var/lib/rancher/rke2/rpm/rke2-selinux-0.22-1.el9.noarch.rpm
{{- with sha256 $selinuxRPM }}
          shasum: {{ . }}
{{- end }}
          selector:
            package: rpm
{{- range $arch := .Arches }}
        - source: {{ $arch.ServerRPM }}
          target: /var/lib/rancher/rke2/rpm/rke2-server-{{ $.RPMVersion }}-0.el9.{{ $arch.RPMArch }}.rpm
{{- with sha256 $arch.ServerRPM }}
          shasum: {{ . }}
{{- end }}
          selector:
            package: rpm
            profile: controller
{{- if $.MultiArch }}
            arch:
              - {{ $arch.Arch }}
{{- end }}
{{- end }}
{{- range $arch := .Arches }}
        - source: {{ $arch.AgentRPM }}
          target: /var/lib/rancher/rke2/rpm/rke2-agent-{{ $.RPMVersion }}-0.el9.{{ $arch.RPMArch }}.rpm
{{- with sha256 $arch.AgentRPM }}
          shasum: {{ . }}
{{- end }}
          selector:
            package: rpm
            profile: worker
{{- if $.MultiArch }}
            arch:
              - {{ $arch.Arch }}
{{- end }}
{{- end }}
{{- range $arch := .Arches }}
        - source: target/{{ $arch.Tarball }}
          extractPath: bin/rke2
          target: /usr/local/bin/rke2
          executable: true
          selector:
            package: binary
{{- if $.MultiArch }}
            arch:
              - {{ $arch.Arch }}
{{- end }}
{{- end }}
{{- range $arch := .Arches }}
        - source: target/{{ $arch.Tarball }}
          extractPath: bin/rke2-killall.sh
          target: /usr/local/bin/rke2-killall.sh
          executable: true
          selector:
            package: binary
{{- if $.MultiArch }}
            arch:
              - {{ $arch.Arch }}
{{- end }}
{{- end }}
{{- range $arch := .Arches }}
        - source: target/{{ $arch.Tarball }}
          extractPath: bin/rke2-uninstall.sh
          target: /usr/local/bin/rke2-uninstall.sh
          executable: true
          selector:
            package: binary
{{- if $.MultiArch }}
            arch:
              - {{ $arch.Arch }}
{{- end }}
{{- end }}
{{- range $arch := .Arches }}
        - source: target/{{ $arch.Tarball }}
          extractPath: lib/systemd/system/rke2-server.service
          target: /etc/systemd/system/rke2-server.service
          symlinks:
            - /etc/systemd/system/multi-user.target.wants/rke2-server.service
          selector:
            package: binary
            profile: controller
{{- if $.MultiArch }}
            arch:
              - {{ $arch.Arch }}
{{- end }}
{{- end }}
{{- range $arch := .Arches }}
        - source: target/{{ $arch.Tarball }}
          extractPath: lib/systemd/system/rke2-agent.service
          target: /etc/systemd/system/rke2-agent.service
          symlinks:
            - /etc/systemd/system/multi-user.target.wants/rke2-agent.service
          selector:
            package: binary
            profile: worker
{{- if $.MultiArch }}
            arch:
              - {{ $arch.Arch }}
{{- end }}
{{- end }}
        - source: {{ $selinuxRPM }}
          target: /var/lib/rancher/rke2/rpm/rke2-selinux-0.22-1.el9.noarch.rpm
{{- with sha256 $selinuxRPM }}
          shasum: {{ . }}
{{- end }}
          selector:
            package: binary
    imageConfig:
      path: /var/lib/rancher/rke2/agent/images
      compression: none
      images:
{{- range .CoreImages }}
        - {{ . }}
{{- end }}
        # {{ .CNI }} cni and add-on images
{{- range .CNIImages }}
        - {{ . }}
{{- end }}
