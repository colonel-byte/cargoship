---
# yaml-language-server: $schema=https://raw.githubusercontent.com/colonel-byte/cargoship/refs/heads/main/schema/zarf-v1alpha1-distro-package-schema.json
kind: ZarfDistro
metadata:
  name: upstream
  version: {{ .Version }}
  architectures:
    - amd64
    - arm64
spec:
  version: {{ .Version }}
  type: upstream
  config:
    os:
      files:
        # Every file this package installs is architecture specific, so each one is listed once per
        # architecture with a selector saying which hosts it belongs to. A host receives only the
        # entries its own architecture selects, and cargoship refuses a selector naming an
        # architecture the package does not declare above. Each entry carries the sha256 its
        # publisher lists for that file, so cargoship verifies what it downloads.
{{- range .Arches }}
{{- range .Deb }}
        - source: {{ .Source }}
          target: {{ .Target }}
          shasum: {{ .SHA256 }}
          selector:
            package: apt
            arch:
              - {{ .Arch }}
{{- end }}
{{- end }}
{{- range .Arches }}
{{- range .RPM }}
        - source: {{ .Source }}
          target: {{ .Target }}
          shasum: {{ .SHA256 }}
          selector:
            package: rpm
            arch:
              - {{ .Arch }}
{{- end }}
{{- end }}
    imageConfig:
      compression: none
      path: /etc/kubernetes/images
      images:
        - registry.k8s.io/kube-apiserver:v{{ .Version }}
        - registry.k8s.io/kube-controller-manager:v{{ .Version }}
        - registry.k8s.io/kube-scheduler:v{{ .Version }}
        - registry.k8s.io/kube-proxy:v{{ .Version }}
        - registry.k8s.io/coredns/coredns:{{ .CoreDNSVersion }}
        - registry.k8s.io/pause:{{ .PauseVersion }}
        - registry.k8s.io/etcd:{{ .EtcdVersion }}
